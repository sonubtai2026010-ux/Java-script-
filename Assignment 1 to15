function calculateBMI(weightKg, heightCm){
 const heightM = heightCm / 100;
 return weightKg / (heightM * heightM);
}
function getCategory(bmi){
 if (bmi < 18.5) return "Underweight";
 if (bmi < 25) return "Normal";
 if (bmi < 30) return "Overweight";
 return "Obese";
}
function getClassName(category){
 const classes = { Underweight: "under", Normal: "normal", Overweight: "over", Obese: "obese" };
 return classes[category];
}
function showBMI(){
 const weight = Number(document.getElementById("weight").value);
 const height = Number(document.getElementById("height").value);
 const box = document.getElementById("result");
 const bmi = Number(calculateBMI(weight, height).toFixed(1));
 const category = getCategory(bmi);
 box.innerText = "Your BMI is " + bmi + " (" + category + ")";
 box.className = "result " + getClassName(category);
}
document.getElementById("calcBtn").addEventListener("click", showBMI);
